# Claude / AI overlay
ANTHROPIC_API_KEY=your_key_here

# News search
TAVILY_API_KEY=your_key_here

# Optional supplemental fundamentals (25 req/day free tier — used sparingly)
ALPHA_VANTAGE_API_KEY=

# Robinhood read-only sync (robinhood-sync.py) — TOTP-based 2FA required
ROBINHOOD_USERNAME=your_robinhood_email
ROBINHOOD_PASSWORD=your_robinhood_password
ROBINHOOD_TOTP_SECRET=your_totp_secret

# Google Sheets (service account) — reuse Jordan/MLB pattern
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Alternative: base64-encoded service account JSON
# GOOGLE_SERVICE_ACCOUNT=

# Upstash Redis (shared instance, pm: prefix for this project)
UPSTASH_REDIS_REST_URL=your_redis_url
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Used to share the generated Sheet with your account
SAM_EMAIL=your_email_here
